NVIDIA_API_KEY=replace-with-your-nvidia-api-key
# Comma-separated exact browser origins; the Next.js server proxy needs no CORS.
CORS_ORIGINS=http://localhost:3000
# Supabase Connect > Transaction pooler, port 6543. URL-encode the password.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations: direct port 5432 (IPv6), or session pooler port 5432 (IPv4).
DIRECT_DATABASE_URL=postgresql+psycopg://postgres:URL_ENCODED_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Preserve stateless legacy clients. Set false to disable them after migration.
LEGACY_INTERVIEW_ENABLED=true
